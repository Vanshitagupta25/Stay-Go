# Backend environment variables (copy to .env and fill values)

# Server / database
PORT=8080
ATLASDB_URL=mongodb://127.0.0.1:27017/staygo
SECRET=replace-with-a-strong-session-secret

# Cloudinary (listing image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mapbox (optional geocoding for listing locations)
MAP_TOKEN=
