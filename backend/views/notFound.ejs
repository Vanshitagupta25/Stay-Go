<% layout("/layouts/boilerplate") %>
<style>
  .btn-custom-outline {
    border: 1px solid #212529;
    color: #212529;
    background-color: transparent;
  }
  .btn-custom-outline:hover {
    background-color: #f8f9fa;
    color: #212529;
  }
</style>

<div class="row mt-5 mb-5">
  <div class="col-8 offset-2 text-center">
    <div class="mb-3 mt-4">
      <i class="fa-solid fa-circle-exclamation text-danger" style="font-size: 4rem;"></i>
    </div>
    <h1 class="display-1 fw-bold text-danger">404</h1>
    <h2 class="mb-3">Page Not Found</h2>
    <h4 class="mb-3">Oops! You are lost</h4>
    <p class="lead mb-1">The page you’re trying to access doesn’t exist or has been moved.</p>
    <p class="text-muted mb-4">Don't worry, check the URL carefully</p>
    
    <div class="d-flex justify-content-center gap-3 mt-4 mb-4">
      <a href="/listings" class="btn btn-dark px-4 py-2">Back to Dashboard</a>
      <a href="javascript:history.back()" class="btn btn-custom-outline px-4 py-2">
        <i class="fa-solid fa-arrow-left me-2"></i>Go Back
      </a>
    </div>

    <p class="text-muted mt-5">
      Need help? <a href="mailto:support@staygo.com" class="text-danger fw-bold text-decoration-none">Contact Support</a>
    </p>
  </div>
</div>
